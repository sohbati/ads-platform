{{ define "new_ad" }}
{{ template "page_open" . }}
<section class="new-ad container">
  <header class="new-ad__intro">
    <h1 class="new-ad__title">{{ .Heading }}</h1>
    <p class="new-ad__desc">{{ if eq .Bootstrap.Mode "edit" }}{{ .T.NewAd.EditIntro }}{{ else }}{{ .T.NewAd.Intro }}{{ end }}</p>
  </header>

  {{ if .LoadError }}
  <p class="new-ad__error" role="alert">{{ .LoadError }}</p>
  {{ else }}
  <form id="new-ad-form" class="new-ad__form" novalidate
    data-need-category="{{ .T.NewAd.NeedCategory }}"
    data-need-title="{{ .T.NewAd.NeedTitle }}"
    data-need-description="{{ .T.NewAd.NeedDescription }}"
    data-too-many="{{ .T.NewAd.TooManyPictures }}"
    data-pictures-add="{{ .T.NewAd.PicturesAdd }}"
    data-picture-remove="{{ .T.NewAd.PictureRemove }}"
    data-picture-view="{{ .T.NewAd.PictureView }}"
    data-picture-close="{{ .T.NewAd.PictureClose }}"
    data-photo-prev="{{ .T.AdDetail.PrevPhoto }}"
    data-photo-next="{{ .T.AdDetail.NextPhoto }}"
    data-photo-counter="{{ .T.AdDetail.PhotoCounter }}"
    data-city-required="{{ .T.NewAd.CityRequired }}"
    data-submitting="{{ if eq .Bootstrap.Mode "edit" }}{{ .T.NewAd.SubmittingEdit }}{{ else }}{{ .T.NewAd.Submitting }}{{ end }}"
    data-submit-label="{{ if eq .Bootstrap.Mode "edit" }}{{ .T.NewAd.SubmitEdit }}{{ else }}{{ .T.NewAd.Submit }}{{ end }}"
  >
    <script type="application/json" id="new-ad-bootstrap">{{ json .Bootstrap }}</script>

    <div class="new-ad__field">
      <span class="new-ad__label">{{ .T.NewAd.City }}</span>
      <div class="new-ad__city">
        <strong id="new-ad-city-name">{{ .Bootstrap.CityName }}</strong>
        <button type="button" class="new-ad__change-city" id="new-ad-change-city">{{ .T.NewAd.ChangeCity }}</button>
      </div>
    </div>

    <div class="new-ad__field">
      <label class="new-ad__label" for="new-ad-category">{{ .T.NewAd.Category }}</label>
      <select id="new-ad-category" name="category_id" required>
        <option value="">{{ .T.NewAd.CategoryPlaceholder }}</option>
      </select>
    </div>

    <div class="new-ad__field">
      <label class="new-ad__label" for="new-ad-title">{{ .T.NewAd.Title }}</label>
      <input id="new-ad-title" name="title" type="text" maxlength="120" required placeholder="{{ .T.NewAd.TitlePlaceholder }}" />
    </div>

    <div class="new-ad__field">
      <label class="new-ad__label" for="new-ad-description">{{ .T.NewAd.Description }}</label>
      <textarea id="new-ad-description" name="description" rows="6" required placeholder="{{ .T.NewAd.DescriptionPlaceholder }}"></textarea>
    </div>

    <div class="new-ad__row">
      <div class="new-ad__field">
        <label class="new-ad__label" for="new-ad-price">{{ .T.NewAd.Price }}</label>
        <input id="new-ad-price" class="new-ad__price" name="price_amount" type="text" inputmode="numeric" autocomplete="off" dir="ltr" />
      </div>
      <div class="new-ad__field">
        <label class="new-ad__label" for="new-ad-price-type">{{ .T.NewAd.PriceType }}</label>
        <select id="new-ad-price-type" name="price_type">
          <option value="fixed">{{ .T.NewAd.PriceFixed }}</option>
          <option value="negotiable">{{ .T.NewAd.PriceNegotiable }}</option>
          <option value="free">{{ .T.NewAd.PriceFree }}</option>
          <option value="salary">{{ .T.NewAd.PriceSalary }}</option>
        </select>
      </div>
    </div>

    <div class="new-ad__field">
      <label class="new-ad__label" for="new-ad-neighborhood">{{ .T.NewAd.Neighborhood }}</label>
      <input id="new-ad-neighborhood" name="neighborhood" type="text" maxlength="80" placeholder="{{ .T.NewAd.NeighborhoodPlaceholder }}" />
    </div>

    <fieldset class="new-ad__attrs">
      <legend>{{ .T.NewAd.Details }}</legend>
      <div id="new-ad-attrs" class="new-ad__attrs-grid"></div>
    </fieldset>

    <div class="new-ad__field">
      <span class="new-ad__label">{{ .T.NewAd.Pictures }}</span>
      {{ if eq .Bootstrap.Mode "edit" }}
      <p class="new-ad__hint">{{ .T.NewAd.PicturesReplaceHint }}</p>
      {{ else }}
      <p class="new-ad__hint">{{ format .T.NewAd.PicturesHint .Bootstrap.MaxPictures }}</p>
      {{ end }}
      <div id="new-ad-photo-grid" class="new-ad__photo-grid"></div>
      <input id="new-ad-pictures" class="visually-hidden" name="pictures" type="file" accept="image/jpeg,image/png,image/webp" multiple />
      <button type="button" class="new-ad__add-photos" id="new-ad-add-photos">{{ .T.NewAd.PicturesAdd }}</button>
    </div>

    <p id="new-ad-message" class="new-ad__message" role="status"></p>
    <button type="submit" class="btn btn--primary btn--lg" id="new-ad-submit">{{ if eq .Bootstrap.Mode "edit" }}{{ .T.NewAd.SubmitEdit }}{{ else }}{{ .T.NewAd.Submit }}{{ end }}</button>
  </form>
  <div id="new-ad-lightbox" class="photo-lightbox" hidden>
    <button type="button" class="photo-lightbox__close" data-photo-close aria-label="{{ .T.NewAd.PictureClose }}">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <button type="button" class="photo-lightbox__nav photo-lightbox__nav--prev" data-photo-prev aria-label="{{ .T.AdDetail.PrevPhoto }}">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M14.5 5.5 8 12l6.5 6.5" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <img class="photo-lightbox__img" data-photo-full alt="" />
    <button type="button" class="photo-lightbox__nav photo-lightbox__nav--next" data-photo-next aria-label="{{ .T.AdDetail.NextPhoto }}">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M9.5 5.5 16 12l-6.5 6.5" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <span class="photo-lightbox__count" data-photo-count></span>
  </div>
  {{ end }}
</section>
{{ template "page_close" . }}
{{ end }}
