{{ define "myinfo_setting" }}
{{ template "page_open" . }}
<section class="section-stub container appearance">
  <h1 class="section-stub__title">{{ .Heading }}</h1>
  {{ if .IsAuthenticated }}{{ template "myinfo_nav" . }}{{ end }}
  <p class="section-stub__desc">{{ .T.Appearance.Description }}</p>

  <div class="theme-picker" id="theme-picker" role="radiogroup" aria-label="{{ .T.Appearance.GroupAria }}">
    {{ range .Themes }}
    <button
      type="button"
      class="theme-swatch"
      role="radio"
      data-theme-id="{{ .ID }}"
      aria-pressed="false"
      aria-checked="false"
    >
      <span class="theme-swatch__preview theme-swatch__preview--{{ .ID }}"></span>
      <span class="theme-swatch__name">{{ .Name }}</span>
    </button>
    {{ end }}
  </div>
</section>
{{ template "page_close" . }}
{{ end }}
