{{ define "login" }}
{{ template "page_open" . }}
<section class="section-stub container login-page">
  <h1 class="section-stub__title">{{ .T.Auth.LoginTitle }}</h1>

  <form id="login-form" class="login-form" novalidate>
    <input type="hidden" id="login-next" value="{{ .NextPath }}" />

    <div class="login-form__step" id="login-step-mobile">
      <label for="login-mobile">{{ .T.Auth.MobileLabel }}</label>
      <input
        id="login-mobile"
        name="mobile"
        type="tel"
        inputmode="numeric"
        autocomplete="tel"
        placeholder="{{ .T.Auth.MobilePlaceholder }}"
        required
      />
      <button type="button" id="login-send-otp" class="btn btn--post">{{ .T.Auth.SendOtp }}</button>
    </div>

    <div class="login-form__step is-hidden" id="login-step-otp">
      <label for="login-otp">{{ .T.Auth.OtpLabel }}</label>
      <input
        id="login-otp"
        name="otp"
        type="text"
        inputmode="numeric"
        maxlength="6"
        pattern="[0-9]{6}"
        placeholder="{{ .T.Auth.OtpPlaceholder }}"
        required
      />
      <button type="button" id="login-verify-otp" class="btn btn--post">{{ .T.Auth.VerifyOtp }}</button>
    </div>

    <p id="login-message" class="login-form__message" role="status" aria-live="polite"></p>
  </form>
</section>
<script src="/static/js/login.js" defer></script>
{{ template "page_close" . }}
{{ end }}
