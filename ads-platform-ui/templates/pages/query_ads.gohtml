{{ define "query_ads" }}
{{ template "page_open" . }}
  {{ $s := .Search }}
  <section
    class="search-results container"
    id="ad-feed"
    aria-label="{{ if and $s $s.Query }}{{ format .T.Search.ResultsFor $s.Query }}{{ else if and $s $s.CategoryTitle }}{{ $s.CategoryTitle }}{{ else }}{{ .CityDisplayName }}{{ end }}"
    data-page="{{ if $s }}{{ $s.Page }}{{ else }}1{{ end }}"
    data-has-more="{{ if and $s $s.HasMore }}true{{ else }}false{{ end }}"
    data-query="{{ if $s }}{{ $s.Query }}{{ end }}"
    data-category="{{ if and $s (ne $s.CategorySlug "all") }}{{ $s.CategorySlug }}{{ end }}"
    data-feed-url="/api/v1/search"
    data-i18n-loading="{{ .T.Search.LoadingMore }}"
    data-i18n-error="{{ .T.Search.LoadMoreError }}"
    data-i18n-retry="{{ .T.Search.Retry }}"
  >

    {{ if or (not $s) $s.Unavailable }}
    <p class="search-results__empty">{{ .T.Search.Unavailable }}</p>
    {{ else if not $s.Ads }}
    <p class="search-results__empty">{{ if or $s.Query $s.CategoryTitle }}{{ .T.Search.Empty }}{{ else }}{{ .T.Search.EmptyBrowse }}{{ end }}</p>
    {{ else }}
    <ul class="ad-grid" id="ad-grid">
      {{ range $s.Ads }}
      <li>
        {{ if .Href }}<a class="ad-card" href="{{ .Href }}">{{ else }}<div class="ad-card">{{ end }}
        <div class="ad-card__media">
          {{ if .Thumbnail }}
          <img class="ad-card__img" src="{{ .Thumbnail }}" alt="" loading="lazy" />
          {{ else }}
          <svg class="icon ad-card__placeholder" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="9" cy="10" r="1.75" stroke="currentColor" stroke-width="1.5"/>
            <path d="m5 17 4.5-4 3.5 3 2.5-2 3.5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          {{ end }}
        </div>
        <div class="ad-card__body">
          <h2 class="ad-card__title">{{ .Title }}</h2>
          <p class="ad-card__price">{{ .Price }}</p>
          <p class="ad-card__meta">
            {{- .Location }}{{ if and .Location .PublishedAt }} · {{ end }}{{ .PublishedAt -}}
          </p>
        </div>
        {{ if .Href }}</a>{{ else }}</div>{{ end }}
      </li>
      {{ end }}
    </ul>
    <div class="ad-feed__status" id="ad-feed-status" hidden></div>
    <div class="ad-feed__sentinel" id="ad-feed-sentinel" aria-hidden="true"></div>
    {{ end }}
  </section>
{{ template "page_close" . }}
{{ end }}
