{{ define "ad_detail" }}
{{ template "page_open" . }}
<section class="ad-detail container"{{ if .Ad }} data-ad-id="{{ .Ad.ID }}"{{ end }}>
  {{ if .NotFound }}
  <p class="search-results__empty">{{ .T.AdDetail.NotFound }}</p>
  {{ else if .Unavailable }}
  <p class="search-results__empty">{{ .T.AdDetail.Unavailable }}</p>
  {{ else if .Ad }}
  {{ $n := len .Ad.Images }}
  <div
    class="ad-gallery"
    data-ad-gallery
    data-count-template="{{ .T.AdDetail.PhotoCounter }}"
  >
    <div class="ad-gallery__stage">
      {{ if .Ad.Images }}
        {{ range $i, $src := .Ad.Images }}
        <img
          class="ad-gallery__img{{ if eq $i 0 }} is-active{{ end }}"
          src="{{ $src }}"
          alt=""
          {{ if ne $i 0 }}loading="lazy"{{ end }}
          data-ad-slide
        />
        {{ end }}
        {{ if gt $n 1 }}
        <button type="button" class="ad-gallery__nav ad-gallery__nav--prev" data-ad-prev aria-label="{{ .T.AdDetail.PrevPhoto }}">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M14.5 5.5 8 12l6.5 6.5" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button type="button" class="ad-gallery__nav ad-gallery__nav--next" data-ad-next aria-label="{{ .T.AdDetail.NextPhoto }}">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9.5 5.5 16 12l-6.5 6.5" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <span class="ad-gallery__count" data-ad-count>{{ format .T.AdDetail.PhotoCounter 1 $n }}</span>
        {{ end }}
      {{ else }}
        <div class="ad-gallery__empty">
          <svg class="icon ad-card__placeholder" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="9" cy="10" r="1.75" stroke="currentColor" stroke-width="1.5"/>
            <path d="m5 17 4.5-4 3.5 3 2.5-2 3.5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span>{{ .T.AdDetail.NoPhotos }}</span>
        </div>
      {{ end }}
    </div>
  </div>

  <div class="ad-detail__body">
    <h1 class="ad-detail__title">{{ .Ad.Title }}</h1>
    <p class="ad-detail__price">{{ .Ad.Price }}</p>
    <p class="ad-detail__meta">
      {{- .Ad.Location }}{{ if and .Ad.Location .Ad.PublishedAt }} · {{ end }}{{ .Ad.PublishedAt -}}
    </p>
    {{ if .Ad.Description }}
    <p class="ad-detail__desc">{{ .Ad.Description }}</p>
    {{ end }}
    {{ if .Ad.HasPhone }}
    <div class="ad-contact" data-ad-contact data-ad-id="{{ .Ad.ID }}">
      <p class="ad-contact__label">{{ .T.AdDetail.ContactLabel }}</p>
      <button
        type="button"
        class="ad-contact__masked"
        data-ad-phone-masked
        aria-label="{{ .T.AdDetail.ShowPhone }}"
      >
        <span dir="ltr">{{ .Ad.PhoneMasked }}</span>
      </button>
      <a class="ad-contact__number" data-ad-phone-revealed hidden dir="ltr" href="#"></a>
      <button type="button" class="btn btn--primary ad-contact__show" data-ad-show-phone>
        {{ .T.AdDetail.ShowPhone }}
      </button>
      <a class="btn btn--primary ad-contact__call" data-ad-call-phone hidden href="#">{{ .T.AdDetail.CallPhone }}</a>
    </div>
    {{ end }}
  </div>
  {{ end }}
</section>
{{ template "page_close" . }}
{{ end }}
