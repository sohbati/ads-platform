{{ define "footer_life" }}
<svg class="site-footer__life" viewBox="0 0 1440 280" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    {{/* left: jellyfish */}}
    <g transform="translate(48 28)" stroke-width="1.6">
      <path d="M10 44c0-24 14-38 34-38s34 14 34 38c0 11-9 19-34 19S10 55 10 44Z"/>
      <path d="M28 38c3-8 9-12 16-12"/>
      <path d="M20 63c-4 20 3 42-2 62"/>
      <path d="M32 66c2 22-3 40 3 60"/>
      <path d="M44 66c4 20 0 38 5 58"/>
      <path d="M56 63c5 18 2 40 7 60"/>
      <path d="M68 60c3 16 8 36 2 56"/>
    </g>

    {{/* left: seahorse */}}
    <g transform="translate(168 98)" stroke-width="1.65">
      <path d="M40 6c9 0 16 7 13 16-3 9-12 11-18 6 3 12 9 24 4 38-5 16-18 24-20 40 14-5 25 2 20 14-7 16-28 11-32-3"/>
      <path d="M35 20c9 2 16-3 18-10"/>
      <path d="M26 18h-10"/>
      <circle cx="44" cy="14" r="1.6" fill="currentColor" stroke="none"/>
    </g>

    {{/* left kelp */}}
    <g transform="translate(24 150)" stroke-width="1.5" opacity="0.75">
      <path d="M18 122c10-30-8-42 6-70 12-26-6-38 4-60"/>
      <path d="M44 122c-8-32 14-44 2-74-10-24 12-36 4-58"/>
      <path d="M68 122c6-28-12-46 8-68 10-22-4-40 10-56"/>
    </g>

    {{/* left bubbles */}}
    <g stroke-width="1.35">
      <circle cx="132" cy="196" r="6"/>
      <circle cx="154" cy="168" r="3.5"/>
      <circle cx="118" cy="154" r="2.4"/>
    </g>

    {{/* left fish school */}}
    <g transform="translate(250 36)" stroke-width="1.5">
      <path d="M0 16c12-9 32-9 44 0-12 9-32 9-44 0Z"/>
      <path d="M44 16l14-9v18Z"/>
      <path d="M22 48c10-7 28-7 38 0-10 7-28 7-38 0Z"/>
      <path d="M60 48l12-7v14Z"/>
    </g>

    {{/* right: whale */}}
    <g transform="translate(980 78)" stroke-width="1.7">
      <path d="M16 72c20-30 76-46 138-30 30 7 52 24 58 40 3 9-4 17-17 15-24-4-44 2-62 13-24 13-52 20-84 9-20-7-36-24-33-47Z"/>
      <path d="M206 84c20-5 34-24 38-40 2 24-6 42-24 52"/>
      <path d="M206 84c14 9 9 26-4 30"/>
      <path d="M74 52c9-20 6-34-9-44"/>
      <circle cx="46" cy="66" r="1.8" fill="currentColor" stroke="none"/>
      <path d="M36 48c-4-14-2-24 7-30"/>
    </g>

    {{/* right: stingray */}}
    <g transform="translate(1248 22) rotate(18)" stroke-width="1.55">
      <path d="M64 44L8 26 64 8l56 18Z"/>
      <path d="M8 26c-16 8-18 22-6 24"/>
      <path d="M64 44c4 20 2 44-8 64"/>
      <circle cx="48" cy="22" r="1.5" fill="currentColor" stroke="none"/>
    </g>

    {{/* right fish */}}
    <g transform="translate(1088 36)" stroke-width="1.45">
      <path d="M0 14c14-9 36-9 48 0-12 9-34 9-48 0Z"/>
      <path d="M48 14l14-8v16Z"/>
    </g>

    {{/* right kelp */}}
    <g transform="translate(1348 148)" stroke-width="1.5" opacity="0.75">
      <path d="M16 124c-10-34 10-46-2-74-8-24 12-36 2-58"/>
      <path d="M42 124c8-30-14-48 2-72 10-26-6-38 6-56"/>
    </g>

    {{/* right bubbles */}}
    <g stroke-width="1.35">
      <circle cx="1210" cy="210" r="6"/>
      <circle cx="1234" cy="184" r="3.4"/>
      <circle cx="1192" cy="168" r="2.2"/>
    </g>

    {{/* turtle, lower-left of center so it peeks under copy */}}
    <g transform="translate(430 168) rotate(-10)" stroke-width="1.55" opacity="0.7">
      <ellipse cx="40" cy="26" rx="26" ry="18"/>
      <path d="M20 26h40M40 10v32M26 16c8 5 20 5 28 0M26 36c8-5 20-5 28 0"/>
      <path d="M64 22c10-8 14-4 10 6"/>
      <path d="M16 16c-12-8-16-2-10 8"/>
      <path d="M18 38c-10 8-8 14 2 10"/>
      <path d="M60 38c10 8 12 4 4-4"/>
    </g>
  </g>
</svg>
{{ end }}
