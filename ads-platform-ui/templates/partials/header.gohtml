{{ define "header" }}
<header class="site-header">
  <div class="site-header__inner container">
    <a href="/query-ads" class="brand" aria-label="{{ .AppName }} — {{ .T.Header.HomeAria }}">
      {{ template "brand_logo" . }}
    </a>

    <form class="header-search" action="/query-ads" method="get" role="search">
      <label for="header-search-input" class="visually-hidden">{{ .T.Header.SearchLabel }}</label>
      <input
        id="header-search-input"
        name="q"
        type="search"
        class="header-search__input"
        placeholder="{{ .T.Header.SearchPlaceholder }}"
        value="{{ .SearchQuery }}"
        autocomplete="off"
      />
      <button type="submit" class="header-search__submit" aria-label="{{ .T.Header.SearchSubmit }}">
        <svg class="icon icon--sm" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.75"/>
          <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
        </svg>
      </button>
    </form>

    <nav class="site-nav" aria-label="{{ .T.Nav.MenuAria }}">
      <button type="button" class="site-nav__link" data-category-open aria-haspopup="dialog" aria-controls="category-modal">{{ .T.Nav.Category }}</button>
    </nav>

    <button
      type="button"
      class="header-city"
      id="header-location-trigger"
      data-location-open="multiple"
      data-location-selected="{{ .LocationSlugsCSV }}"
      aria-label="{{ .T.Header.CityAria }}"
      aria-haspopup="dialog"
      aria-controls="location-modal"
    >
      <svg class="icon icon--sm" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 21s7-4.35 7-11a7 7 0 1 0-14 0c0 6.65 7 11 7 11Z" stroke="currentColor" stroke-width="1.75"/>
        <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.75"/>
      </svg>
      <span id="header-city-label">{{ .CityDisplayName }}</span>
    </button>

    <a href="/new-ad" class="btn btn--post header-post{{ if eq .CurrentPath "/new-ad" }} is-active{{ end }}">{{ .T.Nav.NewAd }}</a>
    <div class="header-account-wrap">
      <button
        type="button"
        class="header-account{{ if hasPrefix .CurrentPath "/my-info" }} is-active{{ end }}"
        id="header-login-trigger"
        aria-label="{{ .T.Header.AccountAria }}"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls="account-menu"
      >
        <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.75"/>
          <path d="M5 20c1.5-4 5-6 7-6s5.5 2 7 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
        </svg>
      </button>
      <div id="account-menu" class="account-menu" hidden role="menu">
        <a href="/my-info/setting" role="menuitem">{{ .T.Appearance.Title }}</a>
        <a href="/my-info" role="menuitem" data-account-authed hidden>{{ .T.Nav.MyInfo }}</a>
        <button type="button" role="menuitem" data-account-login data-account-guest>{{ .T.Nav.Login }}</button>
        <button type="button" role="menuitem" data-account-authed data-logout hidden>{{ .T.Nav.Logout }}</button>
      </div>
    </div>
  </div>
</header>
{{ end }}
