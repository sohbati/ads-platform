{{ define "brand_logo" }}
<span class="brand__logo" aria-hidden="true">
  <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="24" cy="24" r="22" fill="var(--color-brand-blue)"/>
    <circle cx="24" cy="24" r="22" fill="var(--color-primary)" fill-opacity="0.42"/>
    <circle cx="24" cy="24" r="17" stroke="#fff" stroke-opacity="0.55" stroke-width="1.75"/>
    <circle cx="24" cy="24" r="11.5" stroke="#fff" stroke-opacity="0.8" stroke-width="1.6"/>
    <rect x="19.5" y="20.5" width="9" height="6.5" rx="1.75" fill="#fff"/>
  </svg>
</span>
<span class="brand__wordmark" dir="ltr">ruab<span class="brand__tld">.ir</span></span>
{{ end }}
