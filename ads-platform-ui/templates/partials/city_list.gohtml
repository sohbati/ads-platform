{{ define "city_list" }}
<section class="cities" aria-labelledby="cities-heading">
  <div class="container">
    <div class="section-head section-head--row">
      <div>
        <h2 id="cities-heading" class="section-head__title">{{ .T.Cities.Title }}</h2>
        <p class="section-head__desc">{{ .T.Cities.Description }}</p>
      </div>
      <button
        type="button"
        class="section-head__link"
        data-location-open="multiple"
        data-location-selected="{{ .LocationSlugsCSV }}"
      >{{ .T.Cities.AllCities }}</button>
    </div>

    <ul class="city-chips">
      {{- range .PopularCities }}
      <li>
        <a href="{{ .Href }}" class="city-chip{{ if eq $.CitySlug .Slug }} is-active{{ end }}">{{ .Name }}</a>
      </li>
      {{- end }}
    </ul>
  </div>
</section>
{{ end }}
